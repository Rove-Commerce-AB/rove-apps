/tools/webanalyze/*.zip
/tools/webanalyze/*.tgz

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.prod.local
.env.production.local


# typescript
*.tsbuildinfo
next-env.d.ts

.idea/